{
  "name": "shansmusic-desktop",
  "version": "1.0.2",
  "description": "ShaN'sMusic desktop app for Windows",
  "main": "main.js",
  "author": "ShaN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/prepare-icons.mjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist": "npm run icons && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.shanmusic.desktop",
    "productName": "ShaN'sMusic",
    "copyright": "Copyright © ShaN",
    "electronVersion": "43.0.0+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "./scripts/vmp-sign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ShaNsMusic-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShaN'sMusic",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v43.0.0+wvcus",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.3"
  }
}
